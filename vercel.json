{
  "version": 2,
  "builds": [
    {
      "src": "chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "models.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "fixit-favicon.svg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/chat.js"
    },
    {
      "src": "/api/models",
      "dest": "/models.js"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/fixit-favicon.svg",
      "dest": "/fixit-favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
